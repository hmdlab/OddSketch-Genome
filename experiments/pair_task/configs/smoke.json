    "bootstrap": 100,
    "bootstrap_seed": 3101,
    "high_jaccard_threshold": 0.75,
    "jaccard_bins": [0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 1.00],
    "bindash": {
      "bindash_bin": "experiments/tools/bin/bindash",
