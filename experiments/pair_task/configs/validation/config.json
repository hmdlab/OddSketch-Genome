{
  "paths": {
    "outdir": "outputs/validation"
  },
  "make_genomes": {
    "genome_length": 1000000,
    "num_pairs": 1000,
    "mutation_min": 10,
    "mutation_max": 5000,
    "seed_base": 2000
  },
  "validation": {
    "threads": 8,
    "j0": 0.9,
    "pos_mode": "mix",
    "canonical": true,
    "bins": [0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 1.00],
    "bootstrap": 2000,
    "k_sensitivity": {
      "replicates": 10,
      "k_values": [21, 31, 64],
      "hash_seed_base": 800000,
      "sketch_size": 8192
    },
    "oph": {
      "replicates": 10,
      "kmerlen": 64,
      "hash_seed_base": 900000,
      "memory_matched": true,
      "sketch_sizes": [2048, 8192, 32768]
    }
  }
}
